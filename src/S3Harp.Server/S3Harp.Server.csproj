<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The shipped binary is named per the project's naming conventions (see README). -->
    <AssemblyName>s3harp</AssemblyName>
    <!-- Settings bind through generated code; no reflection over S3HarpOptions at runtime. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="ExceptionAdjustments.Server.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <!-- The server's types are internal; only its own test projects see them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="S3Harp.Server.Tests" />
    <InternalsVisibleTo Include="S3Harp.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\S3Harp.Core\S3Harp.Core.csproj" />
  </ItemGroup>
</Project>
