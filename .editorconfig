#### Rules the build enforces ####

[*.cs]
# Every style and code-quality rule the IDE analyzers offer is an error: the option
# lines above say which form each takes, and the code follows them throughout.
# That covers formatting (IDE0055, which proves the layout rules agree with CSharpier),
# naming (IDE1006: private fields camelCase with no prefix), exhaustive enum switches
# (IDE0010/IDE0072), redundant casts and usings, collection expressions, and unused
# members, parameters and values.
dotnet_analyzer_diagnostic.category-Style.severity = error
dotnet_analyzer_diagnostic.category-CodeQuality.severity = error
# The results of fluent and Remove calls are discarded without a `_ =`.
dotnet_diagnostic.IDE0058.severity = none
# An if that returns stays an if; the conditional expression reads worse.
dotnet_diagnostic.IDE0046.severity = none
# Code-quality idioms the code follows throughout; a lapse is a build error.
dotnet_diagnostic.CA1002.severity = error    # no List<T> in public signatures
dotnet_diagnostic.CA1305.severity = error    # culture-sensitive parse and format
dotnet_diagnostic.CA1827.severity = error    # Count() where Any() is meant
dotnet_diagnostic.CA1845.severity = error    # span-based string concatenation
dotnet_diagnostic.CA1846.severity = error    # AsSpan over Substring
dotnet_diagnostic.CA1847.severity = error    # Contains(char) over Contains(string)
dotnet_diagnostic.CA1859.severity = error    # concrete types where they are cheaper
dotnet_diagnostic.CA1860.severity = error    # Count or Length over Any()
dotnet_diagnostic.CA1861.severity = error    # constant arrays as static fields
dotnet_diagnostic.CA1870.severity = error    # cached SearchValues
# The analysis level is "all", so every other code-quality rule is an error too.
# These are the ones the code departs from, each for a reason the code shows.
dotnet_diagnostic.CA1032.severity = none     # exceptions carry an S3 error or a startup message; the standard constructors would be dead code
dotnet_diagnostic.CA1034.severity = none     # outcome records nest as the cases of their result type
dotnet_diagnostic.CA1056.severity = none     # the listen URL is validated text that Kestrel parses
dotnet_diagnostic.CA1308.severity = none     # S3 defines its header and algorithm names in lower case
dotnet_diagnostic.CA5392.severity = none     # the libc P/Invokes are Linux-only; DLL search paths do not apply

# Core owns every disposable it creates: SQLite commands, readers and connections.
[src/S3Harp.Core/**.cs]
dotnet_diagnostic.CA2000.severity = error
# fsync has no asynchronous form, and SQLite's asynchronous methods run synchronously.
dotnet_diagnostic.CA1849.severity = none
# Schema migration text names tables and columns from code constants.
dotnet_diagnostic.CA2100.severity = none

# Request streams and checksums are handed to the pipeline or to a wrapping stream that disposes them.
[src/S3Harp.Server/**.cs]
dotnet_diagnostic.CA2000.severity = none

# The libraries never resume on a captured context.
[src/**.cs]
dotnet_diagnostic.CA2007.severity = error
# Public entry points reject null arguments up front rather than failing somewhere inside.
dotnet_diagnostic.CA1062.severity = error
